#!/usr/bin/env bash
# Mirror the CI "generated docs data is current" guard locally so a stale
# ui-api.generated.ts / changelog.generated.ts can never reach CI. Runs only
# when the outgoing commits touch the sources those files derive from.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Always surface the branch's PR link so it is visible after every push.
branch="$(git rev-parse --abbrev-ref HEAD || true)"
pr_url="$(gh pr view "$branch" --json url --jq .url 2>/dev/null || true)"
if [ -z "$pr_url" ]; then
  repo_url="$(gh repo view --json url --jq .url 2>/dev/null || true)"
  if [ -n "$repo_url" ]; then
    pr_url="$repo_url/pull/new/$branch"
  fi
fi
if [ -n "$pr_url" ]; then
  echo "pre-push: PR -> $pr_url"
else
  echo "pre-push: PR link unavailable (try: gh auth status)"
fi

# Enforce that each version's CHANGELOG entry is dated today, so a release never
# lands with a stale date (the release workflow consumes this entry verbatim).
# Runs on every push to a version branch, catching a push made on a later day
# than the entry was first drafted.
today="$(date +%Y-%m-%d)"
changelog_date_ok() {
  local ver_re="${1//./\\.}" line
  line="$(grep -m1 -E "^## \[${ver_re}\] - " "$2" 2>/dev/null || true)"
  if [ -z "$line" ]; then
    echo "pre-push: no '## [$1]' entry found in $2" >&2
    return 1
  fi
  case "$line" in
    *" - $today") return 0 ;;
    *)
      echo "pre-push: $2 entry for $3 v$1 is not dated today ($today):" >&2
      echo "    $line" >&2
      echo "pre-push: refresh the date to $today before pushing (CHANGELOG date must match the release day)." >&2
      return 1
      ;;
  esac
}

date_fail=0
if [[ "$branch" =~ ui-v([0-9]+\.[0-9]+\.[0-9]+) ]]; then
  changelog_date_ok "${BASH_REMATCH[1]}" packages/ui/CHANGELOG.md ui || date_fail=1
fi
if [[ "$branch" =~ website-v([0-9]+\.[0-9]+\.[0-9]+) ]]; then
  changelog_date_ok "${BASH_REMATCH[1]}" apps/website/CHANGELOG.md website || date_fail=1
fi
[ "$date_fail" -eq 0 ] || exit 1

# Wording of the entry the release workflow will publish, and the property order
# of any stylesheet line this branch adds. Both mirror ui-ci.yml so a push
# cannot fail CI on something a script can decide here in a second.
format_fail=0
node packages/ui/scripts/check-changelog-format.mjs packages/ui/CHANGELOG.md >/dev/null || format_fail=1
node packages/ui/scripts/check-changelog-format.mjs apps/website/CHANGELOG.md >/dev/null || format_fail=1
node packages/ui/scripts/check-css-property-order.mjs --since=origin/main >/dev/null || format_fail=1
if [ "$format_fail" -ne 0 ]; then
  echo "pre-push: convention checks failed; rerun for detail:" >&2
  echo "    pnpm ui check-changelog && pnpm ui check-css-order" >&2
  exit 1
fi

# Diff the outgoing commits against the configured upstream, else origin/main.
if base="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"; then
  :
else
  base="origin/main"
fi

changed="$(git diff --name-only "$base"...HEAD 2>/dev/null || true)"
if ! printf '%s\n' "$changed" | grep -qE '^(packages/ui/src/|packages/ui/CHANGELOG\.md|packages/ui/package\.json)'; then
  exit 0
fi

echo "pre-push: verifying generated docs data is current..."
if ! pnpm run regen-docs >/dev/null 2>&1; then
  echo "pre-push: could not regenerate docs data (is the workspace installed?). Run 'pnpm run regen-docs' manually." >&2
  exit 1
fi

generated='apps/website/src/app/data/ui-api.generated.ts apps/website/src/app/data/changelog.generated.ts apps/website/src/assets/eagami-ui-react.md apps/website/src/assets/eagami-ui-flutter.md apps/website/src/assets/eagami-ui-tokens.json'
if ! git diff --quiet -- $generated; then
  echo >&2
  echo "Generated docs data was stale and has been regenerated in your working tree:" >&2
  git --no-pager diff --stat -- $generated >&2
  echo >&2
  echo "Commit the regenerated file(s), then push again." >&2
  exit 1
fi

echo "pre-push: generated docs data OK"
