{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022"],
    "outDir": "./dist/eagami-ui/schematics",
    "rootDir": "./src/schematics",
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/schematics/**/*.ts"],
  "exclude": ["src/schematics/**/*.spec.ts"]
}
