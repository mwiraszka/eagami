{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "node16",
    // node10 resolution is deprecated in TypeScript 6; node16 is its supported
    // successor for the CommonJS output the Angular CLI loads schematics from
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": ["es2022"],
    "outDir": "./dist/eagami-ui/schematics",
    "rootDir": "./src/schematics",
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/schematics/**/*.ts"],
  "exclude": ["src/schematics/**/*.spec.ts"]
}
