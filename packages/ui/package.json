{
  "name": "@eagami/ui",
  "version": "5.7.0",
  "description": "Lightweight, accessible, themeable Angular UI component library and icon set built on CSS custom properties",
  "author": "Michal Wiraszka <michal@eagami.com>",
  "license": "MIT",
  "keywords": [
    "angular",
    "angular-components",
    "ui",
    "components",
    "component-library",
    "design-system",
    "accessible",
    "a11y",
    "dark-mode",
    "theming",
    "icons",
    "signals",
    "standalone",
    "typescript",
    "css-variables"
  ],
  "homepage": "https://eagami.com/ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/eagami.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/mwiraszka/eagami/issues"
  },
  "sideEffects": false,
  "scripts": {
    "ng": "ng",
    "build": "ng build eagami-ui && tsc -p tsconfig.schematics.json && node scripts/copy-schematics.mjs && node scripts/clean-dist-package.mjs",
    "watch": "ng build eagami-ui --watch --configuration development",
    "test": "ng test eagami-ui --no-watch",
    "test:watch": "ng test eagami-ui --watch",
    "test:coverage": "ng test eagami-ui --coverage --no-watch",
    "format": "prettier --write \"src/**\" \"scripts/**\" \".storybook/**\"",
    "lint": "eslint 'src/**' 'scripts/**' '.storybook/**/*.ts'",
    "check-i18n": "node scripts/check-i18n-drift.mjs src/lib/i18n/messages",
    "check-parity": "node scripts/check-demo-parity.mjs",
    "check-tokens": "node scripts/sync-integration-guides.mjs --check",
    "sync-guides": "node scripts/sync-integration-guides.mjs",
    "storybook": "ng run eagami-ui:storybook",
    "build-storybook": "ng run eagami-ui:build-storybook",
    "docs:api": "compodoc -p tsconfig.doc.json -e json -d dist/compodoc --silent && node scripts/extract-api.mjs",
    "docs:changelog": "node scripts/extract-changelog.mjs",
    "chromatic": "chromatic --project-token $CHROMATIC_PROJECT_TOKEN",
    "publish:lib": "pnpm build && npm publish ./dist/eagami-ui --access public"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/forms": "^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2102.14",
    "@angular-devkit/build-angular": "21.2.14",
    "@angular-devkit/core": "21.2.14",
    "@angular-devkit/schematics": "21.2.14",
    "@angular/build": "21.2.14",
    "@angular/cli": "21.2.14",
    "@angular/common": "21.2.16",
    "@angular/compiler": "21.2.16",
    "@angular/compiler-cli": "21.2.16",
    "@angular/core": "21.2.16",
    "@angular/forms": "21.2.16",
    "@angular/platform-browser": "21.2.16",
    "@angular/platform-browser-dynamic": "21.2.16",
    "@angular/router": "21.2.16",
    "@chromatic-com/storybook": "5.2.1",
    "@compodoc/compodoc": "1.2.1",
    "@eslint/js": "10.0.1",
    "@schematics/angular": "21.2.14",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/angular": "10.5.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.10",
    "chromatic": "17.5.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-storybook": "10.5.0",
    "globals": "17.7.0",
    "jsdom": "26.1.0",
    "ng-packagr": "21.2.5",
    "prettier": "3.9.5",
    "rxjs": "7.8.2",
    "storybook": "10.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10",
    "vitest-axe": "1.0.0-pre.5",
    "zone.js": "0.16.2"
  },
  "engines": {
    "node": ">=20"
  }
}
