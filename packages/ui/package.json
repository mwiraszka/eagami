{
  "name": "@eagami/ui",
  "version": "2.6.0",
  "description": "Lightweight, accessible Angular UI component library built on CSS custom properties",
  "author": "Michal Wiraszka <michal@eagami.com>",
  "license": "MIT",
  "keywords": [
    "angular",
    "ui",
    "component-library",
    "design-system",
    "accessible"
  ],
  "homepage": "https://github.com/mwiraszka/eagami/tree/main/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/eagami.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/mwiraszka/eagami/issues"
  },
  "sideEffects": false,
  "scripts": {
    "ng": "ng",
    "build": "ng build eagami-ui && node scripts/clean-dist-package.mjs",
    "watch": "ng build eagami-ui --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"src/**\"",
    "lint": "eslint 'src/**'",
    "check-i18n": "node scripts/check-i18n-drift.mjs src/lib/i18n/messages",
    "storybook": "ng run eagami-ui:storybook",
    "build-storybook": "ng run eagami-ui:build-storybook",
    "docs:api": "compodoc -p tsconfig.doc.json -e json -d dist/compodoc --silent && node scripts/extract-api.mjs",
    "chromatic": "chromatic --project-token $CHROMATIC_PROJECT_TOKEN",
    "publish:lib": "pnpm build && pnpm publish dist/eagami-ui --no-git-checks --access public"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0"
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2102.14",
    "@angular-devkit/build-angular": "21.2.14",
    "@angular-devkit/core": "21.2.14",
    "@angular/build": "21.2.14",
    "@angular/cli": "21.2.14",
    "@angular/common": "21.2.16",
    "@angular/compiler": "21.2.16",
    "@angular/compiler-cli": "21.2.16",
    "@angular/core": "21.2.16",
    "@angular/forms": "21.2.16",
    "@angular/platform-browser": "21.2.16",
    "@angular/platform-browser-dynamic": "21.2.16",
    "@angular/router": "21.2.16",
    "@chromatic-com/storybook": "5.2.1",
    "@compodoc/compodoc": "1.2.1",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.4.2",
    "@storybook/addon-docs": "10.4.2",
    "@storybook/angular": "10.4.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/node": "25.9.1",
    "chromatic": "17.2.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-storybook": "10.4.2",
    "globals": "17.6.0",
    "jest": "30.4.2",
    "jest-axe": "10.0.0",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "16.1.5",
    "ng-packagr": "21.2.5",
    "prettier": "3.8.3",
    "rxjs": "7.8.2",
    "storybook": "10.4.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.1",
    "zone.js": "0.16.2"
  },
  "engines": {
    "node": ">=20"
  }
}
