{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "eagami-ui": {
      "projectType": "library",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ea",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test-build": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "polyfills": ["zone.js"]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "eagami-ui:test-build",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["src/test-setup.ts"],
            "coverageReporters": ["text-summary", "lcov", "json", "json-summary"],
            "coverageExclude": [
              "src/lib/**/*.stories.ts",
              "src/**/*.spec.ts",
              "src/lib/icons/**"
            ],
            "coverageThresholds": {
              "statements": 90,
              "branches": 90,
              "functions": 90,
              "lines": 90
            }
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "eagami-ui-storybook:build",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "."],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "eagami-ui-storybook:build",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "."],
            "outputDir": "dist/storybook/eagami-ui",
            "statsJson": true
          }
        }
      }
    },
    "eagami-ui-storybook": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ea",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": ".storybook/storybook-host.ts",
            "tsConfig": ".storybook/tsconfig.json",
            "styles": ["src/styles/eagami-ui.scss"],
            "assets": [
              {
                "glob": "**/*",
                "input": "assets",
                "output": "assets"
              }
            ]
          }
        }
      }
    }
  }
}
