{
  "name": "eagami",
  "version": "0.0.0",
  "description": "Monorepo for Eagami UI (the @eagami/ui component library) and eagami.com (the marketing and docs site)",
  "author": "Michal Wiraszka <michal@eagami.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/mwiraszka/eagami#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/eagami.git"
  },
  "bugs": {
    "url": "https://github.com/mwiraszka/eagami/issues"
  },
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "regen-docs": "pnpm ui docs:api && pnpm ui docs:changelog && pnpm ui sync-guides && pnpm website exec prettier --write src/app/data/ui-api.generated.ts src/app/data/changelog.generated.ts",
    "dev": "concurrently --kill-others --names \"web,book\" --prefix-colors \"cyan,magenta\" \"pnpm --filter eagami-website start\" \"pnpm --filter @eagami/ui storybook\"",
    "site": "pnpm --filter eagami-website start",
    "storybook": "pnpm --filter @eagami/ui storybook",
    "ui": "pnpm --filter @eagami/ui",
    "website": "pnpm --filter eagami-website",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "concurrently": "10.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "less",
      "lmdb",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "overrides": {
      "@babel/core": ">=7.29.6",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "@hono/node-server": ">=2.0.5",
      "@isaacs/brace-expansion": "5.0.1",
      "@sigstore/core": ">=3.2.1",
      "@sigstore/verify": ">=3.1.1",
      "ajv@>=7": ">=8.18.0",
      "basic-ftp": ">=5.3.0",
      "body-parser@1": ">=1.20.6",
      "body-parser@2": ">=2.3.0",
      "brace-expansion@1": "1.1.16",
      "brace-expansion@2": "2.1.2",
      "brace-expansion@>=4": ">=5.0.8",
      "diff": "9.0.0",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.4",
      "flatted": "3.4.2",
      "follow-redirects": "1.16.0",
      "handlebars": ">=4.7.9",
      "hono": ">=4.12.27",
      "http-proxy-middleware@2": ">=2.0.10",
      "immutable": "5.1.8",
      "ip-address": "10.2.0",
      "js-yaml": "4.3.0",
      "launch-editor": ">=2.14.1",
      "lodash": "4.18.1",
      "lodash-es": ">=4.18.1",
      "minimatch@9": ">=9.0.7",
      "minimatch@10": ">=10.2.3",
      "morgan": ">=1.11.0",
      "path-to-regexp": "8.4.2",
      "picomatch": "4.0.4",
      "piscina": ">=5.2.0",
      "postcss": ">=8.5.10",
      "qs": ">=6.15.2",
      "rollup": "4.60.3",
      "serialize-javascript": ">=7.0.5",
      "shell-quote": ">=1.9.0",
      "sigstore": ">=4.1.1",
      "smol-toml": "1.6.1",
      "tar": "7.5.19",
      "undici": "8.5.0",
      "uuid": ">=11.1.1",
      "webpack": "5.105.4",
      "webpack-dev-server": ">=5.2.5",
      "websocket-driver": ">=0.7.5",
      "ws": ">=8.20.1"
    }
  }
}
