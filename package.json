{
  "name": "eagami",
  "version": "0.0.0",
  "description": "Monorepo for Eagami UI (the @eagami/ui component library) and eagami.com (the marketing and docs site)",
  "author": "Michal Wiraszka <michal@eagami.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/mwiraszka/eagami#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/eagami.git"
  },
  "bugs": {
    "url": "https://github.com/mwiraszka/eagami/issues"
  },
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "regen-docs": "pnpm ui sync-icons && pnpm ui docs:api && pnpm ui docs:changelog && pnpm ui sync-guides && pnpm website exec prettier --write src/app/data/ui-api.generated.ts src/app/data/changelog.generated.ts",
    "dev": "concurrently --kill-others --names \"web,book\" --prefix-colors \"cyan,magenta\" \"pnpm --filter eagami-website start\" \"pnpm --filter @eagami/ui storybook\"",
    "site": "pnpm --filter eagami-website start",
    "storybook": "pnpm --filter @eagami/ui storybook",
    "ui": "pnpm --filter @eagami/ui",
    "website": "pnpm --filter eagami-website",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "concurrently": "10.0.7"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "less",
      "lmdb",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "overrides": {
      "@babel/core": ">=7.29.6",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "@hono/node-server": ">=2.0.5",
      "@humanfs/node": ">=0.16.8",
      "@isaacs/brace-expansion": "5.0.1",
      "@sigstore/core": ">=3.2.1",
      "@sigstore/verify": ">=3.1.1",
      "ajv@>=7": ">=8.18.0",
      "baseline-browser-mapping": ">=2.11.0",
      "basic-ftp": ">=5.3.0",
      "body-parser@1": ">=1.20.6",
      "body-parser@2": ">=2.4.0",
      "brace-expansion@>=4": ">=5.0.12",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "browserslist": ">=4.28.7",
      "compression": ">=1.8.2",
      "diff": "9.0.0",
      "esbuild": "0.28.2",
      "fast-uri": ">=4.2.3",
      "flatted": "3.4.2",
      "follow-redirects": "1.16.0",
      "glob@13": ">=14.0.2",
      "handlebars": ">=4.7.10",
      "hono": ">=4.13.5",
      "http-proxy-middleware@2": ">=2.0.10",
      "i18next": ">=26.3.4",
      "immutable": "5.1.8",
      "ip-address": ">=10.3.1",
      "js-yaml": ">=4.3.2",
      "launch-editor": ">=2.14.2",
      "lodash": "4.18.1",
      "lodash-es": ">=4.18.1",
      "minimatch@10": ">=10.2.3",
      "minimatch@9": ">=9.0.7",
      "morgan": ">=1.11.0",
      "nanoid@3": ">=3.3.18",
      "path-to-regexp": "8.4.2",
      "picomatch": "4.0.4",
      "piscina": ">=5.3.2",
      "postcss": ">=8.5.18",
      "postcss-selector-parser@7": ">=7.1.3",
      "qs": ">=6.16.1",
      "rollup": "4.60.3",
      "sass": "1.108.2",
      "sass-embedded": "1.108.2",
      "serialize-javascript": ">=7.1.3",
      "shell-quote": ">=1.11.0",
      "sigstore": ">=4.1.1",
      "smol-toml": "1.6.1",
      "source-map-js": ">=1.2.2",
      "tar": "7.5.21",
      "undici": ">=8.12.2",
      "uuid": ">=11.1.1",
      "webpack": "5.112.2",
      "webpack-dev-middleware@6": "7.4.6",
      "webpack-dev-server": ">=5.2.5",
      "websocket-driver": ">=0.7.5",
      "ws": ">=8.20.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "patchedDependencies": {
      "happy-dom@21.0.4": "patches/happy-dom@21.0.4.patch"
    }
  }
}
