{
  "name": "eagami",
  "version": "0.0.0",
  "description": "Monorepo for Eagami UI (the @eagami/ui component library) and eagami.com (the marketing and docs site)",
  "author": "Michal Wiraszka <michal@eagami.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/mwiraszka/eagami#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/eagami.git"
  },
  "bugs": {
    "url": "https://github.com/mwiraszka/eagami/issues"
  },
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "start": "pnpm --filter eagami-website start",
    "storybook": "pnpm --filter @eagami/ui storybook",
    "ui": "pnpm --filter @eagami/ui",
    "website": "pnpm --filter eagami-website"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "less",
      "lmdb",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "overrides": {
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "@hono/node-server": ">=1.19.13",
      "@isaacs/brace-expansion": "5.0.1",
      "basic-ftp": ">=5.3.0",
      "brace-expansion@1": "1.1.13",
      "brace-expansion@2": "2.0.3",
      "brace-expansion@>=4": "5.0.5",
      "diff": "9.0.0",
      "esbuild": "0.27.3",
      "fast-uri": "3.1.2",
      "flatted": "3.4.2",
      "follow-redirects": "1.16.0",
      "handlebars": ">=4.7.9",
      "hono": ">=4.12.18",
      "immutable": "5.1.5",
      "ip-address": "10.2.0",
      "js-yaml": "4.1.1",
      "lodash": "4.18.1",
      "lodash-es": ">=4.18.1",
      "minimatch@9": ">=9.0.7",
      "minimatch@10": ">=10.2.3",
      "path-to-regexp": "8.4.2",
      "picomatch": "4.0.4",
      "postcss": ">=8.5.10",
      "qs": "6.15.1",
      "rollup": "4.60.3",
      "serialize-javascript": ">=7.0.5",
      "smol-toml": "1.6.1",
      "tar": "7.5.15",
      "undici": "8.2.0",
      "uuid": ">=11.1.1",
      "webpack": "5.105.4"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-69873",
        "CVE-2026-4923",
        "CVE-2026-4926"
      ]
    }
  }
}
