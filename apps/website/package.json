{
  "name": "eagami-website",
  "version": "3.14.3",
  "description": "Frontend for eagami.com — docs and marketing site for eagami products and services",
  "author": "Michal Wiraszka <michal@eagami.com>",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/eagami.git",
    "directory": "apps/website"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "start:prod": "ng serve -o --configuration production",
    "build": "ng build --configuration production",
    "build:dev": "ng build",
    "build:prod": "ng build --configuration production",
    "build:stats": "ng build --stats-json && webpack-bundle-analyzer dist/stats.json",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node dist/server/server.mjs",
    "lint": "eslint 'src/**'",
    "format": "prettier --write \"src/**\" --ignore-unknown",
    "check-i18n": "node ../../packages/ui/scripts/check-i18n-drift.mjs src/app/i18n/messages"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.16",
    "@angular/compiler": "21.2.16",
    "@angular/core": "21.2.16",
    "@angular/forms": "21.2.16",
    "@angular/platform-browser": "21.2.16",
    "@angular/platform-browser-dynamic": "21.2.16",
    "@angular/platform-server": "21.2.16",
    "@angular/router": "21.2.16",
    "@angular/ssr": "21.2.14",
    "@eagami/ui": "workspace:*",
    "express": "5.2.1",
    "resend": "6.17.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.14",
    "@angular/cli": "21.2.14",
    "@angular/compiler-cli": "21.2.16",
    "@eslint/js": "10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/express": "5.0.6",
    "@types/node": "25.9.1",
    "@vercel/node": "5.8.23",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "prettier-eslint": "16.4.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  }
}
